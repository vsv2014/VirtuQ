{
  "name": "trynstyle",
  "description": "VirtuQ \u2014 TryNStyle: try-before-you-buy fashion commerce (React client + Express API)",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.11"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/index.js",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{scripts,shared,server,src}/**/*.{ts,tsx,js,mjs,jsx,json,css}\"",
    "format:check": "prettier --check \"{scripts,shared,server,src}/**/*.{ts,tsx,js,mjs,jsx,json,css}\"",
    "preview": "vite preview",
    "server": "node server/index.js",
    "test": "node scripts/unit-test.mjs",
    "test:api": "node scripts/test-api.mjs"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.4.0",
    "framer-motion": "^11.0.8",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.344.0",
    "mongoose": "^8.2.1",
    "qrcode.react": "^3.1.0",
    "react": "^18.3.1",
    "react-countdown": "^2.3.5",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.22.3",
    "socket.io": "^4.7.4",
    "socket.io-client": "^4.7.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "mongodb-memory-server": "^10.1.2",
    "postcss": "^8.4.35",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
