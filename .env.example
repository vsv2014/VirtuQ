# Copy to .env and fill in. NEVER commit .env.

# API server
PORT=3000
NODE_ENV=development

# Mongo connection string
MONGODB_URI=mongodb://localhost/trynstyle

# Auth — REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS: the origin the Vite dev server / deployed client is served from.
# Add extra origins comma-separated in ALLOWED_ORIGINS.
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=

# OTP lifetime (seconds)
OTP_TTL_SECONDS=300

# Where the Vite dev-server proxy forwards /api and /socket.io
VITE_API_TARGET=http://localhost:3000
